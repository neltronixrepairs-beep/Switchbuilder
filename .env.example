# Switchbuilder server configuration
PORT=8787
# Optional: an OpenAI-compatible chat API. Without these values, Switchbuilder uses its local generator.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Set this to a real build-worker endpoint when APK builds are implemented.
BUILD_WORKER_URL=
